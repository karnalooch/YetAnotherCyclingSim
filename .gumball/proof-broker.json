      "cost_class": "heavy",
      "merge_critical": false,
      "dispatch_ref": "default",
      "request_id_input": "gumball_request_id",
      "inputs": {
        "exact_sha": "$sha",
        "gumball_request_id": "$request_id"
      },
      "artifact_name": "proof-$proof-$sha",
      "automatic": {
        "enabled": false,
        "require_ci_class": "heavy"
      },
