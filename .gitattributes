# Normalize text files across operating systems
* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.uproject text eol=lf
*.uplugin text eol=lf
*.ini text eol=lf

# Unreal Engine binary assets

*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
