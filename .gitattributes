# Normalize text files across operating systems
* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.uproject text eol=lf
*.uplugin text eol=lf
*.ini text eol=lf

# Unreal Engine and source media binary assets
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.hip filter=lfs diff=lfs merge=lfs -text
*.hiplc filter=lfs diff=lfs merge=lfs -text
*.hda filter=lfs diff=lfs merge=lfs -text
*.hdalc filter=lfs diff=lfs merge=lfs -text
*.terrain filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text

# Preserve exact bytes of externally pinned source responses (including on Windows).
worldgen/terrain/benchmarks/sa_calobra/*_source_*.json -text
# Pin the owned normalization recipe bytes across Windows/Linux checkouts.
scripts/assets/sa_calobra_context_recipe_v1.json text eol=lf
# Keep the hash-bound BOB inspection policy identical on Windows and Linux.
worldgen/terrain/adaptive_terrain_policy.json text eol=lf
# Native BOB context verifies its complete plugin inventory against Git bytes.
Plugins/YacsBobInspection/Source/YacsBobInspection/YacsBobInspection.Build.cs text eol=lf
# The fixed native-session caller participates in exact source-byte admission.
scripts/ue/Invoke-YacsOfficialMcpBobSession.ps1 text eol=lf
worldgen/materials/*.json text eol=lf
# Retain exact rendered graph bytes and recognize their Windows line endings.
worldgen/materials/material_maker/**/*.ptex -text whitespace=cr-at-eol
worldgen/materials/material_maker/**/export/*.png filter=lfs diff=lfs merge=lfs -text

worldgen/materials/visual_fill/*.png filter=lfs diff=lfs merge=lfs -text

# Retained material-repair evidence and CC0 source images
worldgen/materials/scanned_refinement/source/*.png filter=lfs diff=lfs merge=lfs -text
docs/experiments/sa-calobra-material-repair-20261006/evidence/**/*.png filter=lfs diff=lfs merge=lfs -text
docs/experiments/sa-calobra-material-repair-20261006/evidence/*.png filter=lfs diff=lfs merge=lfs -text
*.snapshot binary

# Retained Component 230 technical evidence
docs/experiments/component230-cliff/evidence/*.zip filter=lfs diff=lfs merge=lfs -text

# Preserve exact copied TPP viewing-aid bytes, including captured CRLF endings.
docs/experiments/sa-calobra-tpp-survey-20261008/*.csv -text whitespace=cr-at-eol
docs/experiments/sa-calobra-tpp-survey-20261008/route.svg -text whitespace=cr-at-eol
docs/experiments/sa-calobra-tpp-survey-20261008/review-guide.txt -text whitespace=cr-at-eol

# Retained source-face pilot JSON is byte-pinned by native/full-map consumers.
docs/experiments/sa-calobra-component230-detail-pilot-20261008/pilot/*.json -text
# Native projection evidence participates in the portable material recipe identity.
docs/experiments/sa-calobra-material-repair-20261006/evidence/native-projection.json -text

# Preserve native detail proof bytes, including Windows-authored JSON receipts.
docs/experiments/sa-calobra-component230-detail-native-20261008/evidence/** -text whitespace=cr-at-eol
