{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yacs.local/schemas/material-forge-world-mask-operation-v1.json",
  "title": "YACS Material Forge world-mask operation",
  "type": "object",
  "required": ["semantic_owner", "operation"],
  "properties": {
    "semantic_owner": {
      "const": "PCG/PCGEx"
    },
    "operation": {
      "enum": ["pack_only", "modulate_detail_only"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"operation": {"const": "pack_only"}}
      },
      "then": {
        "required": ["channels"],
        "properties": {
          "channels": {
            "type": "object",
            "required": ["R"],
            "properties": {
              "R": {"$ref": "#/$defs/worldMask"},
              "G": {"$ref": "#/$defs/worldMask"},
              "B": {"$ref": "#/$defs/worldMask"},
              "A": {"$ref": "#/$defs/worldMask"}
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {"operation": {"const": "modulate_detail_only"}}
      },
      "then": {
        "required": ["world_mask", "detail_mask"],
        "properties": {
          "world_mask": {"$ref": "#/$defs/worldMask"},
          "detail_mask": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "$defs": {
    "worldMask": {
      "type": "object",
      "required": ["name", "path"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
